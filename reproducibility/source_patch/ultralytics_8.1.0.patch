+class DetectSFC(Detect):
+    """YOLOv8 detection head with validation/inference-time support-frequency calibration."""
+
+    def __init__(self, nc=80, class_image_counts=(), num_train_images=1, epsilon=1.0, tau=10.0, beta=1.0, ch=()):
+        super().__init__(nc, ch)
+        if len(class_image_counts) != nc:
+            raise ValueError(f"DetectSFC expected {nc} support counts, got {len(class_image_counts)}")
+        counts = torch.tensor(class_image_counts, dtype=torch.float32)
+        frequency = (counts + epsilon) / (float(num_train_images) + nc * epsilon)
+        signed_adjustment = torch.log((1.0 / nc) / frequency)
+        gate = (counts >= tau).to(torch.float32)
+        self.register_buffer("class_logit_bias", (float(beta) * gate * signed_adjustment).view(1, nc, 1, 1))
+
+    def forward(self, x):
+        """Apply SFC only outside training, before sigmoid and NMS."""
+        raw = []
+        for i in range(self.nl):
+            yi = torch.cat((self.cv2[i](x[i]), self.cv3[i](x[i])), 1)
+            if not self.training:
+                yi = torch.cat((yi[:, : self.reg_max * 4], yi[:, self.reg_max * 4 :] + self.class_logit_bias), 1)
+            raw.append(yi)
+        if self.training:
+            return raw
+
+        shape = raw[0].shape
+        x_cat = torch.cat([xi.view(shape[0], self.no, -1) for xi in raw], 2)
+        if self.dynamic or self.shape != shape:
+            self.anchors, self.strides = (x.transpose(0, 1) for x in make_anchors(raw, self.stride, 0.5))
+            self.shape = shape
+        box, cls = x_cat.split((self.reg_max * 4, self.nc), 1)
+        dbox = self.decode_bboxes(box)
+        y = torch.cat((dbox, cls.sigmoid()), 1)
+        return y if self.export else (y, raw)
+
+
